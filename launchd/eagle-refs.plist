<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Tag-as-you-save: runs `eagle-refs enrich` whenever Eagle changes the library.

  Eagle has no "item added" event for outside tools, but it rewrites the library's mtime.json
  on every add or edit. launchd watches that file (WatchPaths) and runs the job at most once a
  minute (ThrottleInterval), so a burst of saves is one run. The hourly StartInterval is a
  backstop. The write-back touches mtime.json too, which causes one extra run a minute later;
  it finds nothing new and does nothing.

  Replace the four ALL-CAPS paths, then:
    cp eagle-refs.plist ~/Library/LaunchAgents/com.eagle-refs.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.eagle-refs.plist
  Remove:
    launchctl bootout gui/$(id -u)/com.eagle-refs

  NODE: launchd does not read your shell profile, so give the full path (`which node`).
  PATH: launchd's is /usr/bin:/bin:/usr/sbin:/sbin, which has no Homebrew. `enrich` adds
  /opt/homebrew/bin and /usr/local/bin itself so ffmpeg is found.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.eagle-refs</string>

  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/node</string>
    <string>/ABSOLUTE/PATH/TO/eagle-refs/bin/eagle-refs.mjs</string>
    <string>enrich</string>
    <string>--config</string>
    <string>/ABSOLUTE/PATH/TO/eagle-refs.config.json</string>
  </array>

  <key>WatchPaths</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/Your Library.library/mtime.json</string>
  </array>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StartInterval</key>
  <integer>3600</integer>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/eagle-refs.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/eagle-refs.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
